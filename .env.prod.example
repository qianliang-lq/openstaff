# OpenStaff Production Environment Configuration
# Copy this file to .env.prod and fill in your values

# =============================================================================
# Service Tokens (REQUIRED - Generate secure tokens for production)
# =============================================================================

# Token for Runtime service to authenticate with Gateway
RUNTIME_SERVICE_TOKEN=change-me-to-secure-random-token

# =============================================================================
# Gateway Configuration
# =============================================================================

# Gateway egress mode: "live" for real HTTP requests, "offline" for demo fixtures
OPENSTAFF_GATEWAY_EGRESS_MODE=live

# =============================================================================
# Runtime Configuration
# =============================================================================

# Demo mode: 0 for live mode (calls Gateway), 1 for offline demo (uses fixtures)
OPENSTAFF_INSIGHT_DEMO=0

# =============================================================================
# Data Storage
# =============================================================================

# Directory for SQLite database (relative to docker-compose.yml or absolute)
OPENSTAFF_DATA_DIR=./data

# Directory for runtime artifacts (insights, logs, etc.)
OPENSTAFF_ARTIFACTS_DIR=./data/artifacts

# Database URL (default: SQLite in data directory)
DATABASE_URL=sqlite://data/openstaff.db

# =============================================================================
# Desktop Client Configuration (for local desktop connecting to cloud)
# =============================================================================

# Public API base URL that desktop clients will connect to
# Examples:
#   - With Caddy: https://openstaff.yourdomain.com
#   - Direct access: http://your-server-ip:3000
#   - Localhost: http://localhost:3000
PUBLIC_API_BASE=https://openstaff.yourdomain.com

# =============================================================================
# Caddy (Optional - for HTTPS)
# =============================================================================

# Your domain name (for Caddy automatic HTTPS)
CADDY_DOMAIN=openstaff.yourdomain.com

# =============================================================================
# Instructions
# =============================================================================
#
# 1. Copy this file:
#    cp .env.prod.example .env.prod
#
# 2. Edit .env.prod and set:
#    - RUNTIME_SERVICE_TOKEN (generate with: openssl rand -hex 32)
#    - PUBLIC_API_BASE (your server's public URL)
#    - CADDY_DOMAIN (if using HTTPS)
#
# 3. Create data directories:
#    mkdir -p data/artifacts
#
# 4. Start services:
#    just prod-up
#
# 5. Configure desktop client:
#    - Open desktop app
#    - Go to Settings
#    - Set API Base URL to PUBLIC_API_BASE value
#
