{
  "name": "openstaff",
  "version": "0.1.0",
  "private": true,
  "description": "OpenStaff / 开源数字员工",
  "scripts": {
    "dev:desktop": "pnpm --filter openstaff-desktop dev",
    "dev:admin": "pnpm --filter openstaff-web-admin dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\""
  },
  "devDependencies": {
    "prettier": "^3.1.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  }
}
