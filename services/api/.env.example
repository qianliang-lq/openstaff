# OpenStaff API Service Environment Variables

# Database
OPENSTAFF_DATABASE_URL=./data/openstaff.db

# Authentication (Slot A - Cloud API Key)
# Used for write operations (POST/PUT/PATCH/DELETE)
# Leave empty for local development (no auth required)
OPENSTAFF_API_KEY=

# Internal Service URLs (BFF)
# Scheduler service for demo fire requests
OPENSTAFF_SCHEDULER_URL=http://127.0.0.1:3002

# Runtime service for insights proxy
OPENSTAFF_RUNTIME_URL=http://127.0.0.1:3003

# Server Port
PORT=3000
