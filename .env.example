# OpenStaff Environment Variables

# API Authentication (REQUIRED for production)
# Generate a secure random key for production deployments
# Example: openssl rand -hex 32
# If not set, API runs without authentication (insecure, only for local dev)
OPENSTAFF_API_KEY=

# Service Ports
PORT_API=3000
PORT_GATEWAY=3001
PORT_SCHEDULER=3002
PORT_RUNTIME=3003

# Internal Service URLs (for API BFF - docs/24-demo-insights-bff.md)
# API uses these to forward demo fire and insights requests to internal services
OPENSTAFF_SCHEDULER_URL=http://127.0.0.1:3002
OPENSTAFF_RUNTIME_URL=http://127.0.0.1:3003

# Frontend Dev Ports
PORT_DESKTOP=5173
PORT_ADMIN=5174

# Log Level (trace, debug, info, warn, error)
RUST_LOG=info
