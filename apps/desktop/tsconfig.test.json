{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "types": ["vitest/globals", "node", "@testing-library/jest-dom"]
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/__tests__/**",
    "src/test/**",
    "src/**/*.contract.test.ts",
    "src/**/*.contract.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ]
}
