{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true
  },
  "include": ["src"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/__tests__/**",
    "src/test/**",
    "src/**/*.contract.test.ts",
    "src/**/*.contract.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ]
}
