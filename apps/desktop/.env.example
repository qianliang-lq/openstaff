# OpenStaff Desktop Environment Variables

# Cloud API Key (Slot A) for OpenStaff control plane authentication
# Used for write operations (Agent CRUD, demo fire, peer messages, etc.)
# Production: Store via Tauri secure storage (OS Keychain)
# Development fallback: Set this environment variable
OPENSTAFF_API_KEY=

# Public API Base URL
# Default: http://123.57.167.155/openstaff (cloud)
# Local development: http://localhost:3000
PUBLIC_API_BASE=
